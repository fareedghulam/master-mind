rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if ID is valid
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() < 100;
    }

    // Helper to validate User
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'balance'])
        && data.email is string
        && data.balance is number
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() < 150))
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() < 30))
        && (!data.keys().hasAny(['city']) || (data.city is string && data.city.size() < 100))
        && (!data.keys().hasAny(['isAdmin']) || data.isAdmin is bool)
        && (!data.keys().hasAny(['role']) || (data.role is string && data.role.size() < 50))
        && (!data.keys().hasAny(['active']) || data.active is bool)
        && (!data.keys().hasAny(['password']) || (data.password is string && data.password.size() < 100));
    }

    // Helper to validate Booking
    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'userEmail', 'category', 'number', 'firstAmount', 'secondAmount', 'timestamp'])
        && data.id is string
        && data.userEmail is string
        && (data.category == 'pakistan_bond' || data.category == 'thailand_lottery' || data.category == 'dubai_draw' || data.category == 'zee_music_draw')
        && data.number is string
        && data.firstAmount is number
        && data.secondAmount is number
        && data.timestamp is string;
    }

    // Helper to validate DealerBooking
    function isValidDealerBooking(data) {
      return data.keys().hasAll(['id', 'dealerId', 'dealerEmail', 'dealerName', 'category', 'number', 'firstAmount', 'secondAmount', 'timestamp'])
        && data.id is string
        && data.dealerId is string
        && data.dealerEmail is string
        && data.dealerName is string
        && (data.category == 'pakistan_bond' || data.category == 'thailand_lottery' || data.category == 'dubai_draw' || data.category == 'zee_music_draw')
        && data.number is string
        && data.firstAmount is number
        && data.secondAmount is number
        && data.timestamp is string;
    }

    // Helper to validate NumberLimit
    function isValidLimit(data) {
      return data.keys().hasAll(['id', 'category', 'number', 'maxAmount'])
        && data.id is string
        && (data.category == 'pakistan_bond' || data.category == 'thailand_lottery' || data.category == 'dubai_draw' || data.category == 'zee_music_draw')
        && data.number is string
        && data.maxAmount is number;
    }

    // Helper to validate Demand
    function isValidDemand(data) {
      return data.keys().hasAll(['id', 'userEmail', 'category', 'number', 'firstAmount', 'secondAmount', 'timestamp', 'status'])
        && data.id is string
        && data.userEmail is string
        && (data.category == 'pakistan_bond' || data.category == 'thailand_lottery' || data.category == 'dubai_draw' || data.category == 'zee_music_draw')
        && data.number is string
        && data.firstAmount is number
        && data.secondAmount is number
        && data.timestamp is string
        && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        // Dealer fields are optional for customer Demands,
        // but mandatory and type-safe when requesterRole is dealer.
        && (!data.keys().hasAny(['requesterRole']) || data.requesterRole == 'customer' || data.requesterRole == 'dealer')
        && (
          !data.keys().hasAny(['requesterRole'])
          || data.requesterRole == 'customer'
          || (
            data.requesterRole == 'dealer'
            && data.keys().hasAll(['dealerId', 'dealerEmail', 'dealerName'])
            && data.dealerId is string
            && data.dealerId.size() > 0
            && data.dealerEmail is string
            && data.dealerName is string
            && data.dealerName.size() < 150
          )
        )
        && (!data.keys().hasAny(['dealerId']) || data.dealerId is string)
        && (!data.keys().hasAny(['dealerEmail']) || data.dealerEmail is string)
        && (!data.keys().hasAny(['dealerName']) || data.dealerName is string);
    }

    // Helper to validate DrawDeadline
    function isValidDeadline(data) {
      return data.keys().hasAll(['category', 'titleUrdu', 'deadlineIso', 'status'])
        && (data.category == 'pakistan_bond' || data.category == 'thailand_lottery' || data.category == 'dubai_draw' || data.category == 'zee_music_draw')
        && data.titleUrdu is string
        && data.deadlineIso is string
        && (data.status == 'open' || data.status == 'closed');
    }

    // Helper to validate Settings
    function isValidSettings(data) {
      return data.keys().hasAll(['adminEmail', 'whatsappNumber'])
        && data.adminEmail is string
        && data.whatsappNumber is string;
    }

    // Helper to validate Transaction
    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'userEmail', 'userName', 'type', 'amount', 'date', 'status'])
        && data.id is string
        && data.userId is string
        && data.userEmail is string
        && data.amount is number
        && data.status is string;
    }

    // Helper functions to identify roles
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'mastermaind.qureshi110@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        ))
      );
    }

    function isDataEntryAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'fareed.ghulam@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dataEntryAdmin'
        ))
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isDataEntryAdmin();
    }

    match /users/{uid} {
      // Fully migrated to Firebase Auth UID architecture
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);

      allow create: if isValidId(uid) && (
        isSuperAdmin() || (
          request.auth != null &&
          request.auth.uid == uid &&
          request.resource.data.balance == 0 &&
          (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
          (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        )
      ) && isValidUser(request.resource.data);

      allow update: if isValidId(uid) && (
        isSuperAdmin() ||

        // Admin refund: only an atomic refund tied to a deleted booking.
        (
          isAdmin() &&
          request.resource.data.balance > resource.data.balance &&
          request.resource.data.lastRefundBookingId is string &&
          request.resource.data.lastRefundBookingId.size() > 0 &&
          getAfter(/databases/$(database)/documents/transactions/$("refund-" + request.resource.data.lastRefundBookingId)).data.type == 'refund' &&
          getAfter(/databases/$(database)/documents/transactions/$("refund-" + request.resource.data.lastRefundBookingId)).data.userId == uid &&
          getAfter(/databases/$(database)/documents/transactions/$("refund-" + request.resource.data.lastRefundBookingId)).data.bookingId == request.resource.data.lastRefundBookingId &&
          getAfter(/databases/$(database)/documents/transactions/$("refund-" + request.resource.data.lastRefundBookingId)).data.amount ==
            request.resource.data.balance - resource.data.balance &&
          !existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastRefundBookingId)) &&
          isValidUser(request.resource.data) &&
          (!('isAdmin' in resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
          (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
          (!('email' in resource.data) || request.resource.data.email == resource.data.email)
        ) ||

        // Admin booking deduction:
        // Wallet decrease, booking creation and ledger entry must
        // happen in the SAME atomic transaction.
        (
          isAdmin() &&
          request.resource.data.balance < resource.data.balance &&
          request.resource.data.balance >= 0 &&
          request.resource.data.lastBookingId is string &&
          request.resource.data.lastBookingId.size() > 0 &&
          isValidUser(request.resource.data) &&

          (!('isAdmin' in resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
          (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
          (!('email' in resource.data) || request.resource.data.email == resource.data.email) &&

          // Exact ledger entry created in the same transaction.
          getAfter(
            /databases/$(database)/documents/transactions/$("tx-booking-" + request.resource.data.lastBookingId)
          ).data.type == 'booking_deduction' &&

          getAfter(
            /databases/$(database)/documents/transactions/$("tx-booking-" + request.resource.data.lastBookingId)
          ).data.userId == uid &&

          getAfter(
            /databases/$(database)/documents/transactions/$("tx-booking-" + request.resource.data.lastBookingId)
          ).data.bookingId == request.resource.data.lastBookingId &&

          getAfter(
            /databases/$(database)/documents/transactions/$("tx-booking-" + request.resource.data.lastBookingId)
          ).data.amount ==
            resource.data.balance - request.resource.data.balance &&

          getAfter(
            /databases/$(database)/documents/transactions/$("tx-booking-" + request.resource.data.lastBookingId)
          ).data.status == 'approved' &&

          // Matching customer booking OR dealer booking must exist
          // after the atomic transaction.
          (
            (
              existsAfter(
                /databases/$(database)/documents/bookings/$(request.resource.data.lastBookingId)
              ) &&
              getAfter(
                /databases/$(database)/documents/bookings/$(request.resource.data.lastBookingId)
              ).data.userEmail.lower() == request.resource.data.email.lower()
            )
            ||
            (
              existsAfter(
                /databases/$(database)/documents/dealerBookings/$(request.resource.data.lastBookingId)
              ) &&
              getAfter(
                /databases/$(database)/documents/dealerBookings/$(request.resource.data.lastBookingId)
              ).data.dealerId == uid
            )
          )
        ) ||

        // Normal customer operation: balance can only decrease.
        (
          request.auth != null &&
          request.auth.uid == uid &&
          isValidUser(request.resource.data) &&
          request.resource.data.balance <= resource.data.balance &&
          request.resource.data.balance >= 0 &&
          (!('isAdmin' in resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
          (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
          (!('email' in resource.data) || request.resource.data.email == resource.data.email)
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidId(bookingId) && isValidBooking(request.resource.data) && (
        isAdmin() || (
          request.auth != null && 
          request.resource.data.userEmail.lower() == request.auth.token.email.lower()
        )
      );
      allow update, delete: if isValidId(bookingId) && (
        isAdmin() || (
          request.auth != null && 
          resource.data.userEmail.lower() == request.auth.token.email.lower()
        )
      );
    }

    match /dealerBookings/{bookingId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.dealerId == request.auth.uid || 
          resource.data.dealerEmail.lower() == request.auth.token.email.lower()
        )
      );
        // Dealer bookings may only be created by an authenticated
        // Firebase account whose server-side user role is actually dealer.
        // UID, dealer email and authenticated email must all match.
        allow create: if isValidId(bookingId)
          && isValidDealerBooking(request.resource.data)
          && (
            isAdmin()
            || (
              request.auth != null
              && request.resource.data.dealerId == request.auth.uid
              && request.resource.data.dealerEmail.lower() == request.auth.token.email.lower()
              && exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dealer'
            )
          );
        // Only Admin or the actual Dealer owner may modify/remove
        // a Dealer Booking. Dealer ownership is verified server-side.
        allow update, delete: if isValidId(bookingId) && (
          isAdmin()
          || (
            request.auth != null
            && resource.data.dealerId == request.auth.uid
            && resource.data.dealerEmail.lower() == request.auth.token.email.lower()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dealer'
          )
        );
    }

    match /limits/{limitId} {
      allow read: if true;
      allow write: if isValidId(limitId) && isValidLimit(request.resource.data) && isAdmin();
    }

    match /demands/{demandId} {
      allow read: if true;
      allow create: if isValidId(demandId) && isValidDemand(request.resource.data) && (
        isAdmin() || (
          request.auth != null && (
            // Customer Demand
            (
              (!request.resource.data.keys().hasAny(['requesterRole']) ||
               request.resource.data.requesterRole == 'customer') &&
              request.resource.data.userEmail.lower() ==
                request.auth.token.email.lower()
            ) ||
            // Dealer Demand
            (
              request.resource.data.requesterRole == 'dealer' &&
              request.resource.data.dealerId == request.auth.uid &&
              request.resource.data.dealerEmail.lower() ==
                request.auth.token.email.lower() &&
              request.resource.data.userEmail.lower() ==
                request.auth.token.email.lower() &&
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dealer'
            )
          )
        )
      );
      // Demand records are controlled by Admin after creation.
      // Customers/Dealers must not be able to modify the Demand payload.
      // This prevents Dealer identity or financial fields from being altered
      // while keeping Admin approval/rejection available.
      allow update: if isValidId(demandId) &&
        isValidDemand(request.resource.data) &&
        isAdmin();
      allow delete: if isValidId(demandId) && isAdmin();
    }

    match /deadlines/{category} {
      allow read: if true;
      allow write: if isValidId(category) && isValidDeadline(request.resource.data) && isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (request.auth != null && (
        resource.data.userEmail.lower() == request.auth.token.email.lower() ||
        resource.data.userId == request.auth.uid
      ));

      allow create: if isValidId(txId) &&
        isValidTransaction(request.resource.data) && (
          isAdmin() ||

          (
            request.auth != null &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.userEmail.lower() == request.auth.token.email.lower() &&

            (
              // Customer booking deduction.
              (
                request.resource.data.type == 'booking_deduction' &&
                request.resource.data.amount > 0
              ) ||

              // Customer refund.
              // Must be the exact refund document for an existing
              // booking owned by this customer, and the booking must
              // be deleted in the same atomic transaction.
              (
                request.resource.data.type == 'refund' &&
                txId == 'refund-' + request.resource.data.bookingId &&
                request.resource.data.bookingId is string &&
                request.resource.data.bookingId.size() > 0 &&
                request.resource.data.amount > 0 &&
                request.resource.data.status == 'approved' &&

                get(
                  /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
                ).data.userEmail.lower() == request.auth.token.email.lower() &&

                request.resource.data.amount ==
                  get(
                    /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
                  ).data.firstAmount +
                  get(
                    /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
                  ).data.secondAmount &&

                !existsAfter(
                  /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
                )
              )
            )
          )
        );

      allow update: if isValidId(txId) && isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /settings/{configId} {
      allow read: if true;
      allow write: if isValidId(configId) && isValidSettings(request.resource.data) && isSuperAdmin();
    }

    match /pakistanBondResults/{resultId} {
      allow read: if true;
      allow write: if isValidId(resultId) && (isSuperAdmin() || isDataEntryAdmin());
    }

    match /thaiLotteryResults/{resultId} {
      allow read: if true;
      allow write: if isValidId(resultId) && (isSuperAdmin() || isDataEntryAdmin());
    }
  }
}
